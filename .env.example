# Optional public HTTPS audio CDN origin. No credentials; included in the bundle.
# Leave unset to serve audio from this deployment's /audio/days/ directory.
# Set to / to enable the same-origin Vercel media rewrite without local media.
# VITE_AUDIO_BASE_URL=https://audio.example.org
# A configured host advertises only what data/audio/publication.json lists as
# byte-verified on that host (the publication gate; docs/audio.md). The 150
# daily recordings predate it and are advertised. Set this to true only after
# every canonical chapter is uploaded, verified and published in that inventory
# (otherwise the build fails naming a missing chapter). A chronological playlist
# appears only when all its chapters and clips are verified too.
# Files present in this build's public/ folder are advertised regardless.
# VITE_AUDIO_CHAPTERS_ENABLED=false

# Optional Cloudflare AI UI. Vercel builds always disable it.
# All VITE_* values are PUBLIC. Provider keys belong in Worker runtime secrets.
VITE_AI_ENABLED=false
VITE_TURNSTILE_SITE_KEY=

{
  "name": "nt-bible-reading",
  "version": "1.0.0",
  "private": true,
  "description": "A smartphone-first Arabic New Testament reader with a 150-day chronological plan.",
  "author": "Albert Alfred <albertalfred429@gmail.com>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albert429/Bible150.git"
  },
  "homepage": "https://sfk-bible-reading.vercel.app/",
  "bugs": {
    "url": "https://github.com/albert429/Bible150/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b tsconfig.app.json && vite build",
    "start": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:e2e": "export AUDIO_TEST_FIXTURES=1 VITE_AUDIO_BASE_URL=https://audio.example.test && npm run build && playwright test",
    "test:visual": "node scripts/capture-preview.mjs",
    "icons:build": "node scripts/export-favicon.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "ai:models": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-ai-models.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "snapshot": "node scripts/snapshot.mjs",
    "app:host:deploy": "node scripts/cloudflare-app.mjs deploy production",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "predev": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-data.js",
    "prebuild": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-data.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "app:host:build": "node scripts/cloudflare-app.mjs build production",
    "app:host:build:dev": "node scripts/cloudflare-app.mjs build dev",
    "app:host:deploy:dev": "node scripts/cloudflare-app.mjs deploy dev"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": "22.x"
  }
}

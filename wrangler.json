{
  "name": "chronosbible",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node scripts/cloudflare-app.mjs build production"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/ai/*"]
  },
  "routes": [
    {
      "pattern": "chronosbible.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "chronosbible-dev",
      "build": {
        "command": "node scripts/cloudflare-app.mjs build dev"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/ai/*"]
      },
      "routes": [
        {
          "pattern": "dev.chronosbible.com",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          {
            "name": "AI",
            "class_name": "AiCoordinator"
          }
        ]
      },
      "vars": {
        "AI_ENABLED": "true",
        "AI_ENVIRONMENT": "dev",
        "AI_ORIGIN": "https://dev.chronosbible.com",
        "AI_GATEWAY_ACCOUNT_ID": "97fcce5ae743571c933e6ebb99b8c93d",
        "AI_GATEWAY_ID": "chronosbible-dev"
      }
    }
  },
  "main": "worker/index.ts",
  "compatibility_flags": ["enable_request_signal"],
  "durable_objects": {
    "bindings": [
      {
        "name": "AI",
        "class_name": "AiCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "ai-v1",
      "new_sqlite_classes": ["AiCoordinator"]
    }
  ],
  "vars": {
    "AI_ENABLED": "false",
    "AI_ENVIRONMENT": "production",
    "AI_ORIGIN": "https://chronosbible.com",
    "AI_GATEWAY_ACCOUNT_ID": "97fcce5ae743571c933e6ebb99b8c93d",
    "AI_GATEWAY_ID": "chronosbible-production"
  }
}

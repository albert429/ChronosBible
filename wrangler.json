{
  "name": "chronosbible",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node scripts/cloudflare-app.mjs build production"
  },
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "chronosbible.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "chronosbible-dev",
      "build": {
        "command": "node scripts/cloudflare-app.mjs build dev"
      },
      "assets": {
        "directory": "./dist"
      },
      "routes": [
        {
          "pattern": "dev.chronosbible.com",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}

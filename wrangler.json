{
  "name": "chronosbible",
  "main": "hosting/cloudflare-app/worker.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "VITE_AUDIO_BASE_URL=/ npm run build && cp hosting/cloudflare-app/_headers dist/_headers"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/audio/days/*",
      "/audio/chapters/assets/*",
      "/audio/clips/*"
    ]
  },
  "routes": [{ "pattern": "chronosbible.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
